# Copy to .env (never commit .env), then: set -a; . ./.env; set +a
DATABASE_URL=postgres://app:app@127.0.0.1:5432/taskdb?sslmode=disable
# Signs login tokens: at least 32 random bytes. Make your own: openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32-output
# Tests that need Postgres use their own database and skip when this is empty.
TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5432/taskdb_test?sslmode=disable
